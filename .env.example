# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="SAP Migration Assessment Agent"
DEBUG=false
LOG_LEVEL=INFO

# ── API Security ──────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sap_agent:sap_agent@postgres:5432/sap_migration
DATABASE_URL_SYNC=postgresql://sap_agent:sap_agent@postgres:5432/sap_migration

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ── LLM Backend ───────────────────────────────────────────────────────────────
# "ica"     = IBM Consulting Advantage (OpenAI-compatible, recommended)
# "openai"  = OpenAI directly
# "watsonx" = ibm-watsonx-ai SDK (needs separate project_id)
LLM_BACKEND=ica

# ── IBM Consulting Advantage (ICA) ────────────────────────────────────────────
# API key: nextgen-beta.ica.ibm.com → Settings → API Keys
ICA_API_KEY=k-your-ibm-consulting-advantage-api-key
# ICA OpenAI-compatible chat completions endpoint
ICA_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat
# Free-tier models (visible on ICA Usage page):
#   meta-llama/llama-4-maverick-17b-instruct-fp8
#   ibm/granite-4-small
#   anthropic/claude-haiku-4-5
ICA_MODEL=meta-llama/llama-4-maverick-17b-instruct-fp8
ICA_TEMPERATURE=0.1
ICA_MAX_TOKENS=4096

# ── OpenAI (only needed when LLM_BACKEND=openai) ──────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1

# ── IBM watsonx direct SDK (only needed when LLM_BACKEND=watsonx) ────────────
WATSONX_API_KEY=k-your-ibm-consulting-advantage-api-key
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_MAX_NEW_TOKENS=4096
WATSONX_TEMPERATURE=0.1

# ── LangSmith ─────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=sap-migration-agent

# ── SAP Connection ────────────────────────────────────────────────────────────
SAP_HOST=your-sap-host
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=RFC_USER
SAP_PASSWORD=your-sap-password
SAP_LANG=EN
SAP_USE_MOCK=true

# ── SAP OData ────────────────────────────────────────────────────────────────
SAP_ODATA_BASE_URL=http://your-sap-host:8080/sap/opu/odata/sap
SAP_ODATA_USER=odata_user
SAP_ODATA_PASSWORD=your-odata-password
