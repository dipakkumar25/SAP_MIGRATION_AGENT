# -- Output: Plotly-generated dashboards (4.7 MB each, Plotly.js embedded) ---
# These contain Plotly minified JS which trips secret scanners.
# Regenerate locally with: python run_sample.py
output/reports/dashboard_demo-*.html
output/reports/dependency_graph_*.html
output/reports/*.html

# All other output files (static HTML dashboards, PDF, DOCX, JSON, MD) are tracked.

# -- Environment: NEVER commit real secrets -----------------------------------
.env
.env.local
.env.*.local
# NOTE: .env.example is intentionally tracked (placeholder values only)

