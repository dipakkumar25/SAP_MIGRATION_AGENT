# -- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# -- Output: ignore HTML (may contain rendered config), PDF, DOCX, PNG --------
# These are regenerated artefacts; run run_sample.py to recreate them locally.
output/reports/*.html
output/reports/*.pdf
output/reports/*.docx
output/reports/*.png
# JSON dashboard data and Markdown runbooks are safe to track
# .gitkeep files keep directory structure in git

# -- Environment: NEVER commit real secrets -----------------------------------
.env
.env.local
.env.*.local
# NOTE: .env.example is intentionally tracked (placeholder values only)

# -- Database -----------------------------------------------------------------
*.db
*.sqlite

# -- Tests --------------------------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# -- IDE ----------------------------------------------------------------------
.vscode/
.idea/
*.swp

# -- Docker -------------------------------------------------------------------
docker-compose.override.yml
