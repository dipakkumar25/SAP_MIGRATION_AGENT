# -- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# -- Output: keep HTML dashboards, JSON, Markdown; ignore binary blobs --------
# Ignore large binary outputs that are regenerated on every run
output/reports/*.pdf
output/reports/*.docx
output/reports/*.png
# HTML dashboards, JSON data files, Markdown runbooks are tracked

# -- Environment: NEVER commit real secrets -----------------------------------
.env
.env.local
.env.*.local
# NOTE: .env.example is intentionally tracked (placeholder values only)

# -- Database -----------------------------------------------------------------
*.db
*.sqlite

# -- Tests --------------------------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# -- IDE ----------------------------------------------------------------------
.vscode/
.idea/
*.swp

# -- Docker -------------------------------------------------------------------
docker-compose.override.yml
